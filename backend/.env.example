# Copy to /etc/cloudapp/env on the VPS, mode 0600 (spec §7.5).
# Nothing here is read from a tracked file — this example carries no real values.

# --- server ---------------------------------------------------------------
CLOUD_ADDR=127.0.0.1:8080
CLOUD_DB=/var/lib/cloudapp/cloud.db

# Exact origins allowed on mutating requests (CSRF check, spec §8).
# Comma-separated. Must include the scheme, no trailing slash.
CLOUD_ORIGINS=https://cloud.faidz.fun

# Derived automatically: Secure cookies unless every origin is plain-HTTP
# localhost. Only set this to override the derivation.
# CLOUD_SECURE_COOKIE=true

# Honour X-Forwarded-For. Correct behind Nginx; without it every request looks
# like 127.0.0.1 and the rate limiter becomes one bucket for the whole internet.
CLOUD_TRUSTED_PROXY=true

# --- accounts -------------------------------------------------------------
CLOUD_SESSION_DAYS=30
CLOUD_DEFAULT_QUOTA=107374182400   # 100 GB, decision D9

# --- backblaze b2 (Step 2) ------------------------------------------------
# Master key: full access, never leaves the server.
B2_KEY_ID=
B2_APP_KEY=

# Upload key: writeFiles only, restricted to namePrefix users/1/ (spec §2.3).
# Its derived short-lived token is what the browser receives.
B2_UPLOAD_KEY_ID=
B2_UPLOAD_APP_KEY=

# Development escape hatch. Without a restricted upload key the server REFUSES
# to mint browser upload credentials rather than silently handing a client the
# master key. Setting this to true lifts that refusal and logs a warning on
# every single use. Never set it in production.
# B2_ALLOW_MASTER_UPLOAD=false

B2_BUCKET_ID=
B2_BUCKET_NAME=faidz-cloud

# Cloudflare-proxied download base (spec §2.5). Without it, B2 egress past the
# free allowance costs $0.01/GB.
B2_CDN_BASE=https://cdn.faidz.fun/f
